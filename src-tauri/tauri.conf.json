{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/src-tauri/gen/schemas/desktop-schema.json",
  "productName": "Figurine Studio",
  "version": "0.1.0",
  "identifier": "com.figurine-studio.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Figurine Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' http://127.0.0.1:8188 ws://127.0.0.1:8188 https://api.pixellab.ai https://fal.run https://api.replicate.com https://api.replicate.com/v1; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "plugins": {}
}
