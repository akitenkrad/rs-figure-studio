{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.75,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint_name}}"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{positive_prompt}}, pixel art style, {{direction}} view, game character sprite, clean lines",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}, blurry, realistic, photo, 3d render, watermark, text",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "direction",
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "IPAdapter",
    "_meta": { "title": "IP-Adapter for character consistency" },
    "inputs": {
      "model": ["11", 0],
      "ipadapter": ["11", 1],
      "image": ["13", 0],
      "weight": "{{ipadapter_weight}}",
      "weight_type": "standard",
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "11": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": { "title": "Load IP-Adapter model" },
    "inputs": {
      "model": ["4", 0],
      "preset": "PLUS (high strength)"
    }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{reference_image}}"
    }
  }
}
