{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": "{{denoise_strength}}",
      "model": ["12", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["11", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint_name}}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{positive_prompt}}, pixel art style, game character sprite, clean lines, transparent background",
      "clip": ["12", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}, blurry, realistic, photo, 3d render, watermark, text",
      "clip": ["12", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "pixel_art",
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{input_image}}"
    }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["10", 0],
      "vae": ["4", 2]
    }
  },
  "12": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "{{lora_name}}",
      "strength_model": "{{lora_strength_model}}",
      "strength_clip": "{{lora_strength_clip}}",
      "model": ["4", 0],
      "clip": ["4", 1]
    }
  }
}
