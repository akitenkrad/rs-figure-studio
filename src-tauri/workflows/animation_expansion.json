{
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg_scale}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.65,
      "model": ["4", 0],
      "positive": ["10", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{positive_prompt}}, pixel art style, {{direction}} view, {{animation_name}} pose, frame {{frame_index}}, game character sprite",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}, blurry, realistic, photo, 3d render, watermark, text",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "anim_frame",
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "IPAdapterApply",
    "_meta": { "title": "IP-Adapter for animation frame consistency" },
    "inputs": {
      "ipadapter": ["11", 0],
      "clip_vision": ["12", 0],
      "image": ["13", 0],
      "model": ["4", 0],
      "weight": "{{ipadapter_weight}}",
      "noise": 0.0,
      "weight_type": "standard"
    }
  },
  "11": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "ip-adapter-faceid-plusv2_sdxl.bin"
    }
  },
  "12": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip-vit-h-14-laion2B-s32B-b79K.safetensors"
    }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{reference_image}}"
    }
  }
}
